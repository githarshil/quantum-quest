# ==============================================================================
# Quantum Quest — Production Environment Variables
# Copy this file to .env and configure your values.
# NEVER commit real secrets (.env is ignored in .gitignore).
# ==============================================================================

# --- BACKEND HOST (FastAPI / Qiskit Aer / RAG) ---
PORT=8000
ALLOWED_ORIGINS=https://quantum-quest-app.netlify.app,http://localhost:5173

# Gemini API (Server-side only — NEVER expose to frontend)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Supabase (Server-side vector & database access)
SUPABASE_URL=https://uaoqujoqyglutdlgnuqy.supabase.co
SUPABASE_SERVICE_KEY=

# --- NETLIFY / FRONTEND (Public client environment variables) ---
VITE_SUPABASE_URL=https://uaoqujoqyglutdlgnuqy.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:8000
